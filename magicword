local function isTrackerValid(player)
    local data = trackers[player]
    if not data or not data.beam or not data.glowBeam or not data.targetAttachment or not data.billboard then
        return false
    end
    if not data.beam.Parent or not data.glowBeam.Parent or not data.targetAttachment.Parent or not data.billboard.Parent then
        return false
    end

    local character = player.Character
    if not character then return false end

    local targetRoot = character:FindFirstChild("HumanoidRootPart")
    local targetHead = character:FindFirstChild("Head")

    if not targetRoot or not targetHead or data.targetRoot ~= targetRoot or data.targetHead ~= targetHead then
        return false
    end

    return true
end

