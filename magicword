-- FIXED MOBILE & PC COMPATIBLE SLIDER
local function AddSlider(parent, text, min, max, default, callback)
    local container = Instance.new("Frame")
    container.Name = "SliderContainer_" .. text
    container.Parent = parent
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, -6, 0, 42)

    local label = Instance.new("TextLabel")
    label.Parent = container
    label.Size = UDim2.new(1, 0, 0, 18)
    label.BackgroundTransparency = 1
    label.Text = text .. ": " .. tostring(default)
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.Font = Enum.Font.SourceSans
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left

    local sliderBg = Instance.new("Frame")
    sliderBg.Parent = container
    sliderBg.Position = UDim2.new(0, 0, 0, 20)
    sliderBg.Size = UDim2.new(1, 0, 0, 18)
    sliderBg.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
    sliderBg.BorderSizePixel = 0

    local sliderFill = Instance.new("Frame")
    sliderFill.Parent = sliderBg
    sliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    sliderFill.BackgroundColor3 = UIStroke.Color
    sliderFill.BorderSizePixel = 0
    table.insert(accentHeaders, sliderFill)

    local touchBtn = Instance.new("TextButton")
    touchBtn.Parent = sliderBg
    touchBtn.Size = UDim2.new(1, 0, 1, 0)
    touchBtn.BackgroundTransparency = 1
    touchBtn.Text = ""
    touchBtn.ZIndex = 10

    local isDragging = false

    local function UpdateSlider(input)
        local inputPos = input.Position.X
        local percent = math.clamp((inputPos - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        local value = math.floor((min + (max - min) * percent) * 10) / 10
        
        sliderFill.Size = UDim2.new(percent, 0, 1, 0)
        label.Text = text .. ": " .. tostring(value)
        
        if callback then callback(value) end
    end

    touchBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            UpdateSlider(input)
            
            local currentParent = parent
            while currentParent and not currentParent:IsA("ScrollingFrame") do
                currentParent = currentParent.Parent
            end
            if currentParent then
                currentParent.ScrollingEnabled = false
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if isDragging then
                isDragging = false
                
                local currentParent = parent
                while currentParent and not currentParent:IsA("ScrollingFrame") do
                    currentParent = currentParent.Parent
                end
                if currentParent then
                    currentParent.ScrollingEnabled = true
                end
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateSlider(input)
        end
    end)

    return container
end

