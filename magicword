    local player = Players.LocalPlayer

    local function reviveAtCurrentSpot()
        local char = player.Character
        if not char then return end
        
        local root = char:FindFirstChild(__dec("d73052a801c643481182a061fdd72eba"))
        if not root then return end

        getgenv().SavedDeathCFrame = root.CFrame

        local args = {
            [1] = {
                [__dec("d92c4dba1be74b4126")] = __dec("db2c5aae00"),
                [__dec("d82051ad0adb")] = __dec("dd2a46"),
                [__dec("d3244cbd21c84749")] = __dec("dc374ab30ec745"),
                [__dec("db0a7d")] = __dec("ac7512f85f84181c73d8"),
            }
        }
        
        game:GetService(__dec("cd204fa506ca4b5826899c61c2c43da94a")):WaitForChild(__dec("cc305da406dd63482683bb7cd9cf")):FireServer(unpack(args))
    end

    if not getgenv().ReviveLoopStarted then
        getgenv().ReviveLoopStarted = true
        
        player.CharacterAdded:Connect(function(newChar)
            if getgenv().SavedDeathCFrame then
                local targetCFrame = getgenv().SavedDeathCFrame
                
                local startTime = tick()
                local connection
                
                connection = RunService.RenderStepped:Connect(function()
                    local newRoot = newChar:FindFirstChild(__dec("d73052a801c643481182a061fdd72eba"))
                    if newRoot then
                        newRoot.CFrame = targetCFrame + Vector3.new(0, 3, 0)
                        newRoot.AssemblyLinearVelocity = Vector3.zero
                    end
                    
                    if tick() - startTime > 2 then
                        connection:Disconnect()
                        getgenv().SavedDeathCFrame = nil
                    end
                end)
            end
        end)
    end

    reviveAtCurrentSpot()
end)

