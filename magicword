
local function __dec(s)
  local K={0x6a,0x13,0xf4,0x03,0x28,0x5a,0x3a,0x12,0xf5,0x79,0x72,0x08,0xba,0x0a,0x28,0xba}
  local N={0x65,0xed,0xbb,0xf5,0x42,0x0d,0x11,0x3f}
  local b={}
  for i=1,#s,2 do b[#b+1]=tonumber(s:sub(i,i+1),16) end
  local o={} local st=0
  for i=1,#b do
    st=(st+N[((i-1)%8)+1])%256
    o[i]=string.char((b[i]~K[((i-1)%16)+1]~st)%256)
  end
  return table.concat(o)
end

