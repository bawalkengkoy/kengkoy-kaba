
local K={0x46,0xbd,0x89,0xa2,0x68,0x30,0x4e,0x7a,0x58,0x30,0xdf,0x3e,0x59,0x5a,0xa0,0x82}
local N={0x5e,0x2a,0x1f,0xee,0xcd,0xb4,0xc8,0xfb}
local H=""

local function _dec(s)
  local b={}
  for i=1,#s,2 do b[#b+1]=tonumber(s:sub(i,i+1),16) end
  local o={} local st=0
  for i=1,#b do
    st=(st+N[((i-1)%8)+1])%256
    o[i]=string.char((b[i]~K[((i-1)%16)+1]~st)%256)
  end
  return table.concat(o)
end

local __P = _dec(H)
local _load = loadstring or load
return _load(__P, "=obf")()
