
local function __dec(s)
  local K={0xfb,0x6f,0x80,0x4c,0xa3,0xef,0x3b,0x59,0x54,0x70,0xfc,0x58,0x2e,0x22,0x0e,0xb0}
  local N={0x5d,0x0c,0x18,0x4c,0x8f,0xfd,0xb9,0x8b}
  local b={}
  for i=1,#s,2 do b[#b+1]=tonumber(s:sub(i,i+1),16) end
  local o={} local st=0
  for i=1,#b do
    st=(st+N[((i-1)%8)+1])%256
    o[i]=string.char((b[i]~K[((i-1)%16)+1]~st)%256)
  end
  return table.concat(o)
end

