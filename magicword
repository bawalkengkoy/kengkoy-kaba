--==================================================
-- FLY LOGIC
--==================================================

local function stopFly()
	if not flyEnabled then return end

	flyEnabled = false
	jumpHeld = false
	downHeld = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if bodyGyro then
		bodyGyro:Destroy()
		bodyGyro = nil
	end

	if bodyVelocity then
		bodyVelocity:Destroy()
		bodyVelocity = nil
	end

	if humanoid then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true
	end
end

local function startFly()
	if flyEnabled then return end

	if not character or not humanoid or not humanoidRootPart then
		getCharacter()
	end

	if not humanoid or not humanoidRootPart then return end

	flyEnabled = true

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.Name = "HirayaFlyGyro"
	bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	bodyGyro.P = 90000
	bodyGyro.D = 1000
	bodyGyro.Parent = humanoidRootPart

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Name = "HirayaFlyVelocity"
	bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bodyVelocity.P = 90000
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = humanoidRootPart

	humanoid.PlatformStand = true
	humanoid.AutoRotate = false

	flyConnection = RunService.RenderStepped:Connect(function()
		if not flyEnabled then return end

		if not character or not character.Parent or not humanoid or not humanoid.Parent or not humanoidRootPart or not humanoidRootPart.Parent then
			stopFly()
			return
		end

		local camera = workspace.CurrentCamera
		if not camera then return end

		local moveDirection = humanoid.MoveDirection
		local horizontalDirection = Vector3.new(moveDirection.X, 0, moveDirection.Z)
		local vertical = 0

		if jumpHeld then vertical = vertical + 1 end
		if downHeld then vertical = vertical - 1 end

		local velocity = Vector3.zero
		if horizontalDirection.Magnitude > 0 then
			velocity = horizontalDirection.Unit * flySpeed
		end

		velocity = velocity + Vector3.new(0, vertical * flySpeed, 0)
		bodyVelocity.Velocity = velocity

		local lookVector = camera.CFrame.LookVector
		if lookVector.Magnitude > 0 then
			bodyGyro.CFrame = CFrame.lookAt(humanoidRootPart.Position, humanoidRootPart.Position + lookVector)
		end
	end)
end

