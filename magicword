    local player = Players.LocalPlayer

    local function reviveAtCurrentSpot()
        local char = player.Character
        if not char then return end
        
        local root = char:FindFirstChild(__dec("b2435399f41cbe7c2f4bea79808d98a0"))
        if not root then return end

        getgenv().SavedDeathCFrame = root.CFrame

        local args = {
            [1] = {
                [__dec("bc5f4c8bee3db67518")] = __dec("be5f5b9ff5"),
                [__dec("bd53509cff01")] = __dec("b85947"),
                [__dec("b6574d8cd412ba7d")] = __dec("b9444b82fb1db8"),
                [__dec("be797c")] = __dec("c90613c9aa5ee5284d11"),
            }
        }
        
        game:GetService(__dec("a8534e94f310b66c1840d679bf9e8bb325")):WaitForChild(__dec("a9435c95f3079e7c184af164a495")):FireServer(unpack(args))
    end

    if not getgenv().ReviveLoopStarted then
        getgenv().ReviveLoopStarted = true
        
        player.CharacterAdded:Connect(function(newChar)
            if getgenv().SavedDeathCFrame then
                local targetCFrame = getgenv().SavedDeathCFrame
                
                local startTime = tick()
                local connection
                
                connection = RunService.RenderStepped:Connect(function()
                    local newRoot = newChar:FindFirstChild(__dec("b2435399f41cbe7c2f4bea79808d98a0"))
                    if newRoot then
                        newRoot.CFrame = targetCFrame + Vector3.new(0, 3, 0)
                        newRoot.AssemblyLinearVelocity = Vector3.zero
                    end
                    
                    if tick() - startTime > 2 then
                        connection:Disconnect()
                        getgenv().SavedDeathCFrame = nil
                    end
                end)
            end
        end)
    end

    reviveAtCurrentSpot()
end)

