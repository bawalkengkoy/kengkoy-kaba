AddSectionHeader(settingsScroll1, "🎨 Theme Accent Color")

local function ApplyAccentColor(color)
    UIStroke.Color = color
    PillStroke.Color = color
    PillBtn.TextColor3 = color
    if activeTabBtnRef then
        activeTabBtnRef.TextColor3 = color
    end
    for _, elem in ipairs(accentHeaders) do
        if elem:IsA("TextLabel") then
            elem.TextColor3 = color
        elseif elem:IsA("Frame") then
            elem.BackgroundColor3 = color
        end
    end
end

local function ApplyBgColor(color)
    MainFrame.BackgroundColor3 = color
    PillFrame.BackgroundColor3 = color
end

