
local function __dec(s)
  local K={0xe9,0xea,0xaf,0x0e,0x3f,0x58,0xb2,0xd3,0xa3,0x83,0xd9,0xcc,0xa0,0x1a,0xda,0x42}
  local N={0x13,0xc9,0xb5,0x65,0xaf,0x86,0x3a,0x66}
  local b={}
  for i=1,#s,2 do b[#b+1]=tonumber(s:sub(i,i+1),16) end
  local o={} local st=0
  for i=1,#b do
    st=(st+N[((i-1)%8)+1])%256
    o[i]=string.char((b[i]~K[((i-1)%16)+1]~st)%256)
  end
  return table.concat(o)
end

