local currentToggleKey = Enum.KeyCode.Insert

local keybindLabel = Instance.new("TextLabel")
keybindLabel.Parent = settingsScroll2
keybindLabel.Size = UDim2.new(1, -6, 0, 20)
keybindLabel.BackgroundTransparency = 1
keybindLabel.Text = "Toggle Key: " .. currentToggleKey.Name
keybindLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
keybindLabel.Font = Enum.Font.SourceSans
keybindLabel.TextSize = 12
keybindLabel.TextXAlignment = Enum.TextXAlignment.Left

local keybindBtn = AddButton(settingsScroll2, "Set Toggle Keybind", function() end)
keybindBtn.MouseButton1Click:Connect(function()
    keybindBtn.Text = "Press any key..."
    keybindBtn.TextColor3 = UIStroke.Color
    local conn
    conn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            if input.KeyCode ~= Enum.KeyCode.Escape then
                currentToggleKey = input.KeyCode
                keybindLabel.Text = "Toggle Key: " .. input.KeyCode.Name
            end
            keybindBtn.Text = "Set Toggle Keybind"
            keybindBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            conn:Disconnect()
        end
    end)
end)

-- Dynamic Keybind Listener
UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == currentToggleKey then
        if PillFrame.Visible then
            PillFrame.Visible = false
            MainFrame.Visible = true
        else
            MainFrame.Visible = not MainFrame.Visible
        end
    end
end)

