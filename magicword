-- Background Blur Option
local blurEffect = Lighting:FindFirstChild("DiegoBlur")
local function SetBlur(state)
    if state then
        if not blurEffect then
            blurEffect = Instance.new("BlurEffect")
            blurEffect.Name = "DiegoBlur"
            blurEffect.Size = 18
            blurEffect.Parent = Lighting
        end
    else
        if blurEffect then
            blurEffect:Destroy()
            blurEffect = nil
        end
    end
end

AddToggle(settingsScroll1, "Background Blur when GUI open", false, function(on)
    SetBlur(on)
end)

