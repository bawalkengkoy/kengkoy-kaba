local function removeTracker(player)
    local data = trackers[player]
    if not data then return end

    if data.beam then data.beam:Destroy() end
    if data.glowBeam then data.glowBeam:Destroy() end
    if data.targetAttachment then data.targetAttachment:Destroy() end
    if data.billboard then data.billboard:Destroy() end

    trackers[player] = nil
end

local function removeAllTrackers()
    for player in pairs(trackers) do
        removeTracker(player)
    end
    if folder then
        folder:ClearAllChildren()
    end
end

local function getCharacterParts(player)
    local character = player.Character
    if not character then return nil, nil end

    local root = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")

    if not root or not head then return nil, nil end
    return root, head
end

local function createTracker(player)
    if not TRACKING or player == LocalPlayer then return end

    local myCharacter = LocalPlayer.Character
    if not myCharacter then return end

    local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local targetRoot, targetHead = getCharacterParts(player)
