local function switchTab(tabName)
    clickSound:Play()
    for name, page in pairs(tabs) do
        if name == tabName then
            page.Visible = true
            if tabButtons[name] then
                tabButtons[name].BackgroundColor3 = Color3.fromRGB(22, 22, 26)
                tabButtons[name].BackgroundTransparency = 0
            end
        else
            page.Visible = false
            if tabButtons[name] then
                tabButtons[name].BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                tabButtons[name].BackgroundTransparency = 1
            end
        end
    end
end

