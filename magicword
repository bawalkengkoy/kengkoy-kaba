
local function __dec(s)
  local K={0xd6,0xa6,0x8e,0x3d,0xfb,0x2e,0x5f,0xf4,0x62,0x56,0x46,0xd9,0xc1,0xe9,0x11,0x7e}
  local N={0x49,0x9a,0xce,0x43,0xa0,0xf3,0xee,0x63}
  local b={}
  for i=1,#s,2 do b[#b+1]=tonumber(s:sub(i,i+1),16) end
  local o={} local st=0
  for i=1,#b do
    st=(st+N[((i-1)%8)+1])%256
    o[i]=string.char((b[i]~K[((i-1)%16)+1]~st)%256)
  end
  return table.concat(o)
end

