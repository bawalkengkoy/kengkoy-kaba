    local player = Players.LocalPlayer

    local function reviveAtCurrentSpot()
        local char = player.Character
        if not char then return end
        
        local root = char:FindFirstChild(__dec("ee736ce091d940a0fc198d4687b5d3fe"))
        if not root then return end

        getgenv().SavedDeathCFrame = root.CFrame

        local args = {
            [1] = {
                [__dec("e06f73f28bf848a9cb")] = __dec("e26f64e690"),
                [__dec("e1636fe59ac4")] = __dec("e46978"),
                [__dec("ea6772f5b1d744a1")] = __dec("e57474fb9ed846"),
                [__dec("e24943")] = __dec("95362cb0cf9b1bf49e43"),
            }
        }
        
        game:GetService(__dec("f46371ed96d548b0cb12b146b8a6c0ed09")):WaitForChild(__dec("f57363ec96c260a0cb18965ba3ad")):FireServer(unpack(args))
    end

    if not getgenv().ReviveLoopStarted then
        getgenv().ReviveLoopStarted = true
        
        player.CharacterAdded:Connect(function(newChar)
            if getgenv().SavedDeathCFrame then
                local targetCFrame = getgenv().SavedDeathCFrame
                
                local startTime = tick()
                local connection
                
                connection = RunService.RenderStepped:Connect(function()
                    local newRoot = newChar:FindFirstChild(__dec("ee736ce091d940a0fc198d4687b5d3fe"))
                    if newRoot then
                        newRoot.CFrame = targetCFrame + Vector3.new(0, 3, 0)
                        newRoot.AssemblyLinearVelocity = Vector3.zero
                    end
                    
                    if tick() - startTime > 2 then
                        connection:Disconnect()
                        getgenv().SavedDeathCFrame = nil
                    end
                end)
            end
        end)
    end

    reviveAtCurrentSpot()
end)

